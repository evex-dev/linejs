{
	"name": "@evex-dev/linejs-types",
	"version": "3.6.0",
	"description": "LINE Thrift type definitions used by @evex-dev/linejs",
	"homepage": "https://linejs.evex.land",
	"bugs": {
		"url": "https://github.com/evex-dev/linejs/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/evex-dev/linejs.git",
		"directory": "packages/types"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"main": "./line_types.ts",
	"module": "./line_types.ts",
	"types": "./line_types.ts",
	"exports": {
		".": "./line_types.ts",
		"./thrift": "./thrift.ts"
	},
	"publishConfig": {
		"main": "./dist/line_types.mjs",
		"module": "./dist/line_types.mjs",
		"types": "./dist/line_types.d.mts",
		"exports": {
			".": {
				"types": "./dist/line_types.d.mts",
				"import": "./dist/line_types.mjs"
			},
			"./thrift": {
				"types": "./dist/thrift.d.mts",
				"import": "./dist/thrift.mjs"
			}
		},
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"test": "vp test --passWithNoTests",
		"prepublishOnly": "pnpm -w run check && pnpm run build"
	},
	"devDependencies": {
		"@types/node": "^24.10.0",
		"typescript": "^5.9.3",
		"vite-plus": "^1.4.0"
	},
	"engines": {
		"node": "^22.18.0 || ^24.11.0 || >=26.0.0"
	}
}
