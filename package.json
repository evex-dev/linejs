{
	"name": "linejs-monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm --filter './packages/*' -r run build",
		"test": "pnpm --filter './packages/*' -r run test",
		"test:scripts": "vp test",
		"check": "pnpm --filter './packages/*' -r run check",
		"format": "pnpm --filter './packages/*' -r run format",
		"docs:dev": "pnpm --filter linejs-docs run dev",
		"docs:build": "pnpm --filter linejs-docs run build"
	},
	"devDependencies": {
		"typescript": "^5.9.3",
		"vite-plus": "^1.4.0"
	},
	"engines": {
		"node": "^22.18.0 || ^24.11.0 || >=26.0.0"
	},
	"packageManager": "pnpm@12.6.0"
}
