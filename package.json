{
	"name": "linejs-monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm --filter './packages/*' -r run build",
		"test": "pnpm --filter './packages/*' -r run test",
		"test:scripts": "vp test",
		"line": "tsx packages/cli/src/bin.ts",
		"check": "vp check && pnpm run typecheck",
		"format": "vp fmt . --write",
		"docs:dev": "pnpm --filter linejs-docs run dev",
		"docs:build": "pnpm --filter linejs-docs run build",
		"typecheck": "pnpm --filter \"./packages/*\" -r run typecheck"
	},
	"devDependencies": {
		"@evex-dev/linejs": "workspace:*",
		"@evex-dev/linejs-types": "workspace:*",
		"jsdom": "^25.0.0",
		"thrift": "^0.23.0",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"undici": "^7.16.0",
		"vite-plus": "^1.4.0",
		"xxhash-wasm": "^1.1.0"
	},
	"engines": {
		"node": "^22.18.0 || ^24.11.0 || >=26.0.0"
	},
	"packageManager": "pnpm@12.16.1"
}
